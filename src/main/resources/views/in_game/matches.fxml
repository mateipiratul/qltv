<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.qltv.controllers.MatchController"
      spacing="30"
      style="-fx-padding: 10;">

    <VBox HBox.hgrow="ALWAYS" spacing="20">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Matches &amp; Schedules" styleClass="header-label" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Filter by tournament..." prefWidth="250" style="-fx-background-radius: 20;"/>
            <Button text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
        </HBox>
        
        <TableView fx:id="matchTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTournament" text="Tournament" prefWidth="250"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
                <TableColumn fx:id="colFormat" text="Format" prefWidth="100"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="addButton" text="Add New" onAction="#handleClear" styleClass="primary-button"/>
            <Button fx:id="editButton" text="Edit Selected" onAction="#onEditMatch" styleClass="secondary-button"/>
            <Button fx:id="deleteButton" text="Delete Selected" onAction="#handleDelete" styleClass="danger-button"/>
        </HBox>

        <Pagination fx:id="pagination" pageCount="1" />

        <VBox spacing="10" styleClass="form-container">
            <Label text="Match Preview" style="-fx-font-weight: bold;"/>
            <HBox alignment="CENTER" spacing="50">
                <VBox alignment="CENTER" spacing="10">
                    <Label fx:id="teamALabel" text="Team A" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>
                <Label text="VS" style="-fx-font-size: 32px; -fx-text-fill: #94a3b8;"/>
                <VBox alignment="CENTER" spacing="10">
                    <Label fx:id="teamBLabel" text="Team B" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
            <Separator/>
            <Label text="Maps Played" style="-fx-font-weight: bold;"/>
            <ListView fx:id="mapInstancesListView" prefHeight="100"/>
            <HBox alignment="CENTER_RIGHT" spacing="10">
               <Button fx:id="statsButton" text="Manage Stats &amp; Maps" onAction="#onViewStats" styleClass="primary-button"/>
            </HBox>
        </VBox>
    </VBox>

    <VBox fx:id="formContainer" spacing="20" prefWidth="350" styleClass="form-container">
        <Label text="Schedule Match" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        
        <VBox spacing="8">
            <Label text="Tournament" styleClass="text-bold"/>
            <ComboBox fx:id="tournamentComboBox" promptText="Select Tournament" maxWidth="Infinity"/>
        </VBox>
        
        <VBox spacing="8">
            <Label text="Date" styleClass="text-bold"/>
            <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
        </VBox>
        
        <VBox spacing="8">
            <Label text="Format" styleClass="text-bold"/>
            <ComboBox fx:id="formatComboBox" promptText="Select Format" maxWidth="Infinity"/>
        </VBox>

        <Separator/>
        <Label text="Participating Teams (Derived from Stats)" style="-fx-font-weight: bold; -fx-text-fill: #64748b; -fx-font-size: 11px;"/>
        
        <VBox spacing="8">
            <Label text="Team A" styleClass="text-bold"/>
            <TextField fx:id="formTeamAField" editable="false" promptText="Calculated automatically..."/>
        </VBox>
        
        <VBox spacing="8">
            <Label text="Team B" styleClass="text-bold"/>
            <TextField fx:id="formTeamBField" editable="false" promptText="Calculated automatically..."/>
        </VBox>
        
        <Region VBox.vgrow="ALWAYS" />

        <HBox spacing="10">
            <Button text="Schedule" onAction="#handleSave" styleClass="primary-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Clear" onAction="#handleClear" styleClass="secondary-button"/>
        </HBox>
        
        <Button text="Cancel Match" onAction="#handleDelete" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" maxWidth="Infinity"/>
    </VBox>

</HBox>
