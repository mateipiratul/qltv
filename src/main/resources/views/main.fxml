<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.qltv.controllers.MainController"
      spacing="20"
      styleClass="main-container">

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Esports Management Dashboard" styleClass="header-label" style="-fx-padding: 0;"/>
            <Label text="Overview of the Counter-Strike competitive scene &amp; latest announcements" style="-fx-text-fill: #7f8c8d;"/>
        </VBox>
        <Button text="Refresh" styleClass="secondary-button" onAction="#onRefresh"/>
        <Button fx:id="exportAuditButton" text="Export Audit Log" styleClass="secondary-button" onAction="#onExportAuditLog"/>
        <Button fx:id="postNewsButton" text="Post Announcement" styleClass="primary-button" onAction="#onPostNews"/>
    </HBox>
    
    <Separator/>

    <HBox spacing="30" VBox.vgrow="ALWAYS">
        <VBox spacing="20" prefWidth="550" minWidth="400" HBox.hgrow="ALWAYS">
            <GridPane hgap="15" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
                <VBox styleClass="kpi-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label fx:id="teamsCountLabel" text="0" styleClass="kpi-value" />
                    <Label text="TOTAL TEAMS" styleClass="kpi-label" />
                </VBox>
                <VBox styleClass="kpi-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label fx:id="playersCountLabel" text="0" styleClass="kpi-value" />
                    <Label text="TOTAL PLAYERS" styleClass="kpi-label" />
                </VBox>
                <VBox styleClass="kpi-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label fx:id="tournamentsCountLabel" text="0" styleClass="kpi-value" />
                    <Label text="ACTIVE TOURNAMENTS" styleClass="kpi-label" />
                </VBox>
                <VBox styleClass="kpi-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label fx:id="sponsorsCountLabel" text="0" styleClass="kpi-value" />
                    <Label text="ACTIVE SPONSORS" styleClass="kpi-label" />
                </VBox>
            </GridPane>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox spacing="20">
                    <VBox styleClass="form-container" spacing="10">
                        <Label text="Top 20 Teams World Ranking" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1e293b;" />
                        <ListView fx:id="topTeamsListView" prefHeight="230" />
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>

        <VBox spacing="15" prefWidth="650" HBox.hgrow="ALWAYS">
            <Label text="Latest Community Announcements" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1e293b;" />
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                <VBox fx:id="newsContainer" spacing="20" styleClass="news-feed">
                </VBox>
            </ScrollPane>
            <Pagination fx:id="pagination" pageCount="1" />
        </VBox>
    </HBox>

</VBox>
