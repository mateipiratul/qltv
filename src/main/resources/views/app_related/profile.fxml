<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.qltv.controllers.ProfileController"
      spacing="30"
      style="-fx-padding: 30;">

    <Label text="My Profile &amp; Settings" styleClass="header-label"/>

    <HBox spacing="50">
        <!-- Profile Info Section -->
        <VBox spacing="20" styleClass="form-container" prefWidth="400">
            <Label text="General Information" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Separator/>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Username:" styleClass="text-bold" prefWidth="100"/>
                <Label fx:id="usernameLabel" text="admin"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Email:" styleClass="text-bold" prefWidth="100"/>
                <Label fx:id="emailLabel" text="admin@qltv.com"/>
            </HBox>

            <VBox spacing="8">
                <Label text="Profile Picture URL" styleClass="text-bold"/>
                <TextField fx:id="profilePicField" promptText="https://example.com/me.png"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Nationality" styleClass="text-bold"/>
                <ComboBox fx:id="countryComboBox" maxWidth="Infinity" promptText="Select Country"/>
            </VBox>

            <Button text="Update Profile" onAction="#handleUpdateProfile" styleClass="primary-button" maxWidth="Infinity"/>
        </VBox>

        <!-- Security Section -->
        <VBox spacing="20" styleClass="form-container" prefWidth="400">
            <Label text="Security &amp; Password" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Separator/>

            <VBox spacing="8">
                <Label text="Current Password" styleClass="text-bold"/>
                <PasswordField fx:id="oldPasswordField" promptText="Required for changes"/>
            </VBox>

            <VBox spacing="8">
                <Label text="New Password" styleClass="text-bold"/>
                <PasswordField fx:id="newPasswordField" promptText="Min 8 chars, 1 special, 1 upper"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Confirm New Password" styleClass="text-bold"/>
                <PasswordField fx:id="confirmPasswordField"/>
            </VBox>

            <Button text="Change Password" onAction="#handleChangePassword" styleClass="secondary-button" maxWidth="Infinity"/>
        </VBox>
    </HBox>

</VBox>
