<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.qltv.controllers.AuthController"
      alignment="CENTER" spacing="20"
      style="-fx-background-color: #f0f2f5;"
      prefHeight="600.0" prefWidth="900.0">

    <VBox spacing="25" alignment="CENTER" maxWidth="400" 
          style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 20, 0, 0, 10);">
        
        <Label text="QLTV Login" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        
        <VBox spacing="10">
            <Label text="Username or Email" styleClass="text-bold"/>
            <TextField fx:id="loginIdentifierField" promptText="Enter your username or email" prefHeight="45" 
                       style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
        </VBox>
        
        <VBox spacing="10">
            <Label text="Password" styleClass="text-bold"/>
            <PasswordField fx:id="loginPasswordField" promptText="Enter your password" prefHeight="45"
                           style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
        </VBox>
        
        <StackPane>
            <Button fx:id="loginButton" text="Sign In" onAction="#handleLogin" 
                    styleClass="primary-button" maxWidth="Infinity" prefHeight="50"/>
            <ProgressIndicator fx:id="loginProgress" maxWidth="30" maxHeight="30" visible="false"/>
        </StackPane>
        
        <HBox spacing="5" alignment="CENTER">
            <Label text="Don't have an account?" styleClass="text-muted"/>
            <Hyperlink text="Create one now" onAction="#showRegisterForm" style="-fx-text-fill: #3b82f6; -fx-font-weight: bold;"/>
        </HBox>
        
        <Label fx:id="loginErrorLabel" style="-fx-text-fill: #ef4444;" visible="false"/>
    </VBox>
</VBox>
