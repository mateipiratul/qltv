<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.qltv.controllers.TournamentController"
      spacing="20"
      style="-fx-padding: 10;">

    <Label text="Tournaments &amp; Events" styleClass="header-label"/>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search tournaments..." prefWidth="250" style="-fx-background-radius: 20;"/>
        <ComboBox fx:id="typeFilter" prefWidth="150" promptText="Event Type" />
        <Button text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
    </HBox>

    <HBox spacing="30" VBox.vgrow="ALWAYS">
        
        <VBox HBox.hgrow="ALWAYS" spacing="15">
            <TableView fx:id="tournamentTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colName" text="Tournament Name" prefWidth="250"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="150"/>
                    <TableColumn fx:id="colLocation" text="Location" prefWidth="150"/>
                    <TableColumn fx:id="colPrize" text="Prize Pool ($)" prefWidth="120"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="addButton" text="Add New" onAction="#onAddTournament" styleClass="primary-button"/>
                <Button fx:id="editButton" text="Edit Selected" onAction="#onEditTournament" styleClass="secondary-button"/>
                <Button fx:id="deleteButton" text="Delete Selected" onAction="#handleDelete" styleClass="danger-button"/>
            </HBox>

            <Pagination fx:id="pagination" pageCount="1" />
            
            <Label text="Participating Teams" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1e293b;"/>
            <ScrollPane fitToHeight="true" prefHeight="100" style="-fx-background-color: transparent;">
                <FlowPane fx:id="teamsFlowPane" hgap="15" vgap="15" style="-fx-padding: 10;"/>
            </ScrollPane>

            <Label text="Matches Played" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1e293b;"/>
            <TableView fx:id="matchTable" prefHeight="150">
                <columns>
                    <TableColumn fx:id="colMatchDate" text="Date" prefWidth="100"/>
                    <TableColumn fx:id="colMatchStage" text="Stage" prefWidth="150"/>
                    <TableColumn fx:id="colMatchFormat" text="Format" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>

        <VBox fx:id="formContainer" spacing="20" prefWidth="350" styleClass="form-container">
            <Label text="Tournament Details" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            
            <VBox spacing="8">
                <Label text="Name" styleClass="text-bold"/>
                <TextField fx:id="nameField" promptText="e.g. Major Copenhagen"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Organizer" styleClass="text-bold"/>
                <ComboBox fx:id="organizerComboBox" promptText="Select Organizer" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Event Type" styleClass="text-bold"/>
                <ComboBox fx:id="eventTypeComboBox" promptText="Select Type" maxWidth="Infinity"/>
            </VBox>
            
            <VBox spacing="8">
                <Label text="Location" styleClass="text-bold"/>
                <TextField fx:id="locationField" promptText="e.g. Copenhagen, Denmark"/>
            </VBox>
            
            <VBox spacing="8">
                <Label text="Total Prize Pool ($)" styleClass="text-bold"/>
                <TextField fx:id="prizeField" promptText="e.g. 1000000"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS" />

            <HBox spacing="10">
                <Button text="Save Event" onAction="#handleSave" styleClass="primary-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Clear" onAction="#handleClear" styleClass="secondary-button"/>
            </HBox>
            
            <Button text="Delete Event" onAction="#handleDelete" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" maxWidth="Infinity"/>
        </VBox>

    </HBox>

</VBox>
